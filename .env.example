# ─────────────────────────────────────────────────────────────────
# Enterprise LLM Security Gateway — Environment Configuration
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control (it is in .gitignore).
# ─────────────────────────────────────────────────────────────────

# ── Gateway Authentication ──────────────────────────────────────
# The API key that clients must send in the Authorization: Bearer header.
# Generate a strong random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEY=your-secret-gateway-api-key-here

# ── Ollama (local LLM) ──────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Redis (rate limiting) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Cloud LLM Providers (optional — leave blank if not used) ────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Database Configuration (Day 6) ──────────────────────────────
# Full database URL (overrides POSTGRES_* vars). Use for production.
DATABASE_URL=postgresql://dev_user:your-secure-postgres-password@localhost:5432/gateway
# By default, if POSTGRES_* vars are empty, the app will fall back to SQLite
# for local testing. For production/Day 6 logging, configure these:
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gateway

# Alternatively, set the full URL directly:
# POSTGRES_URL=postgresql://dev_user:your-secure-postgres-password@localhost:5432/gateway
