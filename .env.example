# ─────────────────────────────────────────────────────────────────
# Enterprise LLM Security Gateway — Environment Configuration
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control (it is in .gitignore).
# ─────────────────────────────────────────────────────────────────

# ── Gateway Authentication ──────────────────────────────────────
# The API key that clients must send in the Authorization: Bearer header.
# Generate a strong random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEY=your-secret-gateway-api-key-here

# ── Ollama (local LLM) ──────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Redis (rate limiting) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Cloud LLM Providers (optional — leave blank if not used) ────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Database Configuration (Day 6) ──────────────────────────────
# Full database URL (overrides POSTGRES_* vars). Use for production.
DATABASE_URL=postgresql://dev_user:your-secure-postgres-password@localhost:5432/gateway
# By default, if POSTGRES_* vars are empty, the app will fall back to SQLite
# for local testing. For production/Day 6 logging, configure these:
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gateway

# Alternatively, set the full URL directly:
# POSTGRES_URL=postgresql://dev_user:your-secure-postgres-password@localhost:5432/gateway

# ── Prompt Injection Detection (Week 3 Day 1) ────────────────────────────────
# Enable/disable the detection layer entirely. Set false only for development
# bypass — never disable in production.
PROMPT_INJECTION_ENABLED=true
# Floating-point threshold [0.0–1.0].  Prompts scored at or above this value
# are classified as injection attempts and blocked (HTTP 403).
PROMPT_INJECTION_THRESHOLD=0.7
# Rebuff ML-based detection (remote cloud API — disabled by default).
# To activate: set REBUFF_ENABLED=true and supply your Rebuff API token.
# Obtain a token at https://playground.rebuff.ai
REBUFF_ENABLED=false
REBUFF_API_TOKEN=your-rebuff-api-token-here
REBUFF_API_URL=https://playground.rebuff.ai

# ── Local ML Prompt Injection Detection (Week 3 Day 2) ─────────────────────
# Set false to disable the local DeBERTa-v3 ML detector (heuristic still runs).
ML_PROMPT_INJECTION_ENABLED=true
# HuggingFace model ID. The model is downloaded once and cached locally
# (default cache: ~/.cache/huggingface/hub/).
ML_PROMPT_INJECTION_MODEL=protectai/deberta-v3-base-prompt-injection-v2
# INJECTION class probability threshold. Scores >= this value are blocked.
# Default 0.5 matches the model's built-in decision boundary.
# Lower = more sensitive (more false positives). Higher = less sensitive.
ML_PROMPT_INJECTION_THRESHOLD=0.5

# ── Content Safety (Week 3 Day 3) ──────────────────────────────────────────
# Enable/disable the response content safety filtering layer.
CONTENT_SAFETY_ENABLED=true
# Risk-score threshold (0.0–1.0).
CONTENT_SAFETY_THRESHOLD=0.7

# ── LLM Response Caching ──────────────────────────────────────────────────
# Set true to enable Redis response caching for identical sanitized prompts.
# Reduces latency to <5ms and avoids duplicate LLM provider charges.
RESPONSE_CACHE_ENABLED=false
RESPONSE_CACHE_TTL_SECONDS=3600
